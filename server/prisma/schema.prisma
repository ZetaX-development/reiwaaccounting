generator client {
  provider      = "prisma-client-js"
  // 'native' covers the host (Linux glibc) for `npm test` / `prisma studio`;
  // 'linux-musl-openssl-3.0.x' covers the alpine-based Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             FirmMember[]
  clients             Client[]
  vendorSyncs         VendorSync[]
  entries             Entry[]
  receipts            Receipt[]
  matchings           Matching[]
  tasks               Task[]
  rules               Rule[]
  threads             Thread[]
  yearendChecks       YearendCheck[]
  trendData           TrendDatum[]
  monthlyChecks       MonthlyCheck[]
  vouchers            Voucher[]
  voucherInquiries    VoucherInquiry[]
  lineUserMappings    LineUserMapping[]
  integrations        Integration[]
  driveFolderMappings DriveFolderMapping[]
  driveWatchChannels  DriveWatchChannel[]
  journalAiReviews    JournalAiReview[]
  todos               Todo[]
  taxSuggestions      TaxSuggestion[]
  cashFlowForecasts   CashFlowForecast[]
  clientPortals       ClientPortal[]
}

model FirmMember {
  id          String    @id @default(cuid())
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId      String
  authUserId  String
  role        String
  email       String
  displayName String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  status      String    @default("invited")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([firmId, authUserId])
  @@index([authUserId])
}

model Client {
  id              String   @id @default(cuid())
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId          String
  name            String
  industry        String   @default("その他")
  vendor          String   @default("mf") // 'freee' | 'mf' | 'both'
  mode            String   @default("monthly") // 'monthly' | 'yearend'
  fiscalYearStart DateTime
  fiscalYearEnd   DateTime
  contactPrimary  String   @default("email")
  contactEndpoints Json    @default("{}")
  receiptPolicyOverrides Json?
  yearendKpi      Json?

  // MF OAuth tokens (encryption is future work)
  mfAccessToken    String?
  mfRefreshToken   String?
  mfTokenExpiresAt DateTime?
  mfExternalId     String?

  // freee OAuth tokens
  freeeAccessToken    String?
  freeeRefreshToken   String?
  freeeTokenExpiresAt DateTime?
  freeeExternalId     String?  // freee company_id

  // CRM fields
  memo          String?
  tags          String[]
  crmStatus     String   @default("active") // active | pending | inactive
  lastContactAt DateTime?

  // Snapshot fields used by dashboard (recomputed on writes)
  progress   Int @default(0)
  tasksOpen  Int @default(0)
  risk       Int @default(0)
  receipt    Int @default(0)
  missing    Int @default(0)
  diff       Int @default(0)
  matches    Int @default(0)

  // Cached display strings
  ownerLabel   String?
  chatMessage  String?
  messageDraft String?

  vendorSyncs       VendorSync[]
  entries           Entry[]
  receipts          Receipt[]
  matchings         Matching[]
  tasks             Task[]
  rules             Rule[]
  threads           Thread[]
  yearendChecklist  YearendCheck[]
  trendData         TrendDatum[]
  monthlyChecks     MonthlyCheck[]
  vouchers          Voucher[]
  driveFolderMappings DriveFolderMapping[]
  todos             Todo[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model VendorSync {
  id        String    @id @default(cuid())
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId    String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  vendor    String
  lastSync  DateTime?
  status    String    @default("ok")
  count     Int       @default(0)
  errorMsg  String?
  @@unique([clientId, vendor])
}

model Entry {
  id            String   @id @default(cuid())
  firm          Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId        String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  source        String
  sourceEntryId String?
  account       String
  description   String
  amount        Int
  taxClass      String?
  occurredAt    DateTime
  receiptStatus String   @default("na")
  score         Int?
  requestedAt   DateTime?
  raw           Json?
  syncedAt      DateTime @default(now())

  @@index([clientId, occurredAt])
  @@unique([source, sourceEntryId])
}

model Receipt {
  id              String   @id @default(cuid())
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId          String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  source          String
  sourceReceiptId String?
  status          String
  vendorRef       String?
  amount          Int?
  occurredAt      DateTime
  raw             Json?
  syncedAt        DateTime @default(now())
}

model Matching {
  id            String   @id @default(cuid())
  firm          Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId        String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  source        String
  invoiceRef    String
  invoiceAmount Int
  paidAmount    Int
  diffNote      String?
  status        String
  occurredAt    DateTime
  raw           Json?
  syncedAt      DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId    String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  title     String
  note      String
  category  String
  status    String
  score     Int      @default(50)
  stage     String   @default("awaiting_approval")
  assignee  String?
  approver  String?
  ruleId    String?
  history   TaskHistory[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model TaskHistory {
  id      String   @id @default(cuid())
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String
  at      DateTime @default(now())
  by      String
  action  String
  comment String?
}

model Rule {
  id        String   @id @default(cuid())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId    String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  type      String   @default("custom")
  industry  String?
  title     String
  detail    String   @default("")
  severity  String   @default("mid")
  active    Boolean  @default(true)
  createdBy String   @default("system")
  createdAt DateTime @default(now())
  hits      RuleHit[]
}

model RuleHit {
  id      String   @id @default(cuid())
  rule    Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId  String
  at      DateTime @default(now())
  target  String
  outcome String   @default("matched")
}

model Thread {
  id          String   @id @default(cuid())
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId      String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  channel     String
  direction   String
  subject     String?
  body        String
  preview     String?
  status      String   @default("queued")
  externalId  String?
  errorMsg    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

model ReceiptPolicy {
  account          String  @id
  requiresReceipt  Boolean @default(true)
  requiresApproval Boolean @default(false)
  exemptUnder      Int?
  notes            String?
}

model YearendCheck {
  id       String  @id @default(cuid())
  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId   String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  title    String
  note     String?
  status   String  @default("open")
  order    Int
}

model TrendDatum {
  id         String   @id @default(cuid())
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId     String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  account    String
  prev3      Json
  curr       Float
  changePct  Float
  flag       String
}

model MonthlyCheck {
  id       String  @id @default(cuid())
  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId   String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  title    String
  note     String?
  detail   String?
  status   String  @default("open")
  score    Int     @default(50)
}

model Voucher {
  id         String   @id @default(cuid())
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId     String
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String?
  filename   String
  mimeType   String
  size       Int
  imageData  Bytes
  uploadedAt DateTime @default(now())
  uploadedBy String?

  ocrJson        Json?
  ocrStatus      String   @default("pending")
  ocrAt          DateTime?
  ocrError       String?
  matchedEntryId String?
  matchStatus    String   @default("unmatched")
  matchedAt           DateTime?
  matchedClientReason String?

  draftJournalJson Json?
  journalStatus    String   @default("none")
  inquiryAt        DateTime?
  inquiryChannel   String?

  // Spec 15: Drive 連携用 / Spec 16: LINE 連携用
  source              String   @default("manual")
  driveFileId         String?  @unique
  driveImportStatus   String?
  lineSourceMessageId String?  @unique
  lineUserId          String?
  caption             String?
  lineAnswers         Json?    // Spec 19: { "field": "answer", ... }

  // Spec 20: MF自動入力
  mfWriteStatus String?   // null | 'pending' | 'writing' | 'done' | 'failed'
  mfWriteError  String?
  mfWriteAt     DateTime?

  inquiries VoucherInquiry[]

  @@index([clientId, uploadedAt])
  @@index([ocrStatus])
}

model VoucherInquiry {
  id           String   @id @default(cuid())
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId       String
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId    String
  channel      String
  target       String
  body         String
  sentAt       DateTime @default(now())
  status       String   @default("sent")
  errorMessage String?

  @@index([voucherId])
}

// Spec 21: MF仕訳AIレビュー
model JournalAiReview {
  id              String   @id @default(cuid())
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId          String
  clientId        String
  mfJournalId     String
  status          String   @default("pending") // pending | approved | skipped | auto_applied | difficult
  aiMemo          String?
  aiConfidence    Float?
  debitAccount    String?
  creditAccount   String?
  amount          Int?
  transactionDate String?
  originalMemo    String?
  errorMsg        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, mfJournalId])
  @@index([firmId, status])
  @@index([clientId])
}

model JournalPattern {
  id            String   @id @default(cuid())
  debit         String
  credit        String
  scenario      String
  memoExamples  String[]
  industry      String?
  tags          String[]
  amountHint    String?
  embeddingJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([debit, credit])
}

model Todo {
  id        String   @id @default(cuid())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId    String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  title     String
  note      String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, done])
}

model Integration {
  id        String   @id @default(cuid())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId    String
  type      String
  creds     Json
  settings  Json     @default("{}")
  enabled   Boolean  @default(true)
  status    String   @default("ok")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, type])
}

model DriveFolderMapping {
  id                  String   @id @default(cuid())
  firm                Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId              String
  driveFolderId       String   @unique
  folderName          String
  importedSubfolderId String?
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clientId])
}

model DriveWatchChannel {
  id         String   @id @default(cuid())
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId     String
  channelId  String   @unique
  resourceId String
  pageToken  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model LineUserMapping {
  id          String   @id @default(cuid())
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId      String
  lineUserId  String
  displayName String
  staffLabel  String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([firmId, lineUserId])
}

// Spec 23: AI節税提案エンジン
model TaxSuggestion {
  id              String   @id @default(cuid())
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId          String
  clientId        String
  category        String   // 'entertainment' | 'depreciation' | 'timing' | 'tax_method' | 'officer_salary' | 'other'
  title           String
  detail          String
  estimatedSaving Int?     // 推定節税額（円）、null=算出困難
  priority        String   @default("medium") // 'high' | 'medium' | 'low'
  status          String   @default("open")   // 'open' | 'implemented' | 'dismissed'
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId, status])
  @@index([firmId])
}

// Spec 24: キャッシュフロー予測
model CashFlowForecast {
  id            String   @id @default(cuid())
  firm          Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId        String
  clientId      String
  forecastMonth String   // 'YYYY-MM'
  inflow        Int      // 収入予測（円）
  outflow       Int      // 支出予測（円）
  net           Int      // 純CF（inflow - outflow）
  aiComment     String?  // AIコメント
  confidence    Float?   // 0-1
  isActual      Boolean  @default(false) // true=実績、false=予測
  createdAt     DateTime @default(now())

  @@unique([clientId, forecastMonth])
  @@index([clientId])
}

// Spec 25: 顧問先ポータル
model ClientPortal {
  id           String    @id @default(cuid())
  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId       String
  clientId     String    @unique
  token        String    @unique @default(cuid())
  enabled      Boolean   @default(true)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
