DATABASE_URL=postgresql://zeimee:zeimee_dev@localhost:5432/zeimee
PORT=3000
NODE_ENV=development
STALE_THRESHOLD_SEC=3600
MAX_AGE_SEC=21600

# Money Forward Cloud Accounting API
# Register an app at https://biz.moneyforward.com/support/app-portal/guide/g011.html
# to obtain CLIENT_ID / CLIENT_SECRET. Redirect URI must be registered exactly.
MF_CLIENT_ID=
MF_CLIENT_SECRET=
MF_REDIRECT_URI=http://localhost:3000/api/mf/oauth/callback
# OAuth authorize/token endpoints (common auth server v2)
MF_AUTH_BASE_URL=https://api.biz.moneyforward.com
# Cloud Accounting data API base (api/v3/journals, /accounts, etc.)
MF_ACCOUNTING_BASE_URL=https://api-accounting.moneyforward.com
# Legacy single-URL var (no longer read by mf-api.ts; keep blank).
MF_BASE_URL=

# Notification (filled in spec 03 implementation)
SENDGRID_API_KEY=
EMAIL_FROM=zeimee@example.com
SLACK_BOT_TOKEN=
CHATWORK_API_TOKEN=

# OpenAI Vision OCR (spec 11)
# Required for voucher OCR. Without this, uploaded vouchers stay in ocrStatus=pending.
OPENAI_API_KEY=
# Default is gpt-5 (highest accuracy). Override to gpt-4o or gpt-4o-mini to lower cost.
OPENAI_VISION_MODEL=gpt-5

# Client outreach (spec 14)
# 'mock' just logs to console + VoucherInquiry table. 'email' / 'line' are
# pluggable adapters whose connection details below are filled in by the
# integrator (real send not implemented yet).
OUTREACH_CHANNEL=mock
# When true, missing-info vouchers automatically send a follow-up inquiry.
# Keep false until adapters are wired so we don't spam clients.
OUTREACH_AUTO=false
OUTREACH_EMAIL_FROM=zeimee@example.com
