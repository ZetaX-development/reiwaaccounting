{
  "name": "bookmee-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=postgresql://bookmee:bookmee_test@localhost:5433/bookmee_test vitest run",
    "test:watch": "DATABASE_URL=postgresql://bookmee:bookmee_test@localhost:5433/bookmee_test vitest",
    "test:db:setup": "DATABASE_URL=postgresql://bookmee:bookmee_test@localhost:5433/bookmee_test prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:patterns": "tsx scripts/seed-journal-patterns.ts",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts",
    "create-firm": "tsx scripts/create-firm.ts",
    "setup-delivery-demo": "tsx scripts/setup-delivery-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "googleapis": "^144.0.0",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.8",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.60.0",
    "undici": "^6.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.0",
    "form-data": "^4.0.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^1.6.1"
  }
}
